# Environment variables necessary for deployment

# DEPLOY_USER = username on the production machine, combined as
# ${DEPLOY_USER}@${DEPLOY_HOST} for SSH access
DEPLOY_USER=example
# DEPLOY_HOST = address of the production machine, combined as
# ${DEPLOY_USER}@${DEPLOY_HOST} for SSH access
DEPLOY_HOST=server.example.net

# DEPLOY_DOMAIN = domain of the deployed instance. The site lives in
# ~/${DEPLOY_DOMAIN} on the production machine
DEPLOY_DOMAIN=example.com
